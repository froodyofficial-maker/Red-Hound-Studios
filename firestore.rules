rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One rating per viewer per film. Doc id is "<filmId>_<uid>".
    match /ratings/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['film', 'uid', 'score', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.film is string
        && id == request.resource.data.film + '_' + request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 10;
      allow delete: if false;
    }
  }
}
